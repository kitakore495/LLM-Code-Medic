# ==============================================================================
# LLM Code Medic - Environment Variables Template (v1.1)
# ==============================================================================
# 使用说明：
# 1. 将此文件复制并重命名为 .env
# 2. 在下方填入你自己的 API Key
# 3. 注意：不要将包含真实 Key 的 .env 文件上传到 GitHub！
# ==============================================================================

# --- 1. OpenAI 配置 (GPT-4o, GPT-4 等) ---
# 获取地址: https://platform.openai.com/
OPENAI_API_KEY=your_openai_key_here

# --- 2. Google 配置 (Gemini 1.5 Pro/Flash) ---
# 获取地址: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_key_here

# --- 3. DeepSeek 配置 (DeepSeek-V3, DeepSeek-R1) ---
# 推荐使用硅基流动 (SiliconFlow) 获取接口: https://cloud.siliconflow.cn/
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_API_BASE=https://api.siliconflow.cn/v1

# --- 4. 项目运行配置 ---
# ACTIVE_MODEL 可选值: gpt, gemini, deepseek
# 修改这个值即可在代码中快速切换模型，方便队员 B 测试不同 AI
ACTIVE_MODEL=deepseek

# 调试模式配置 (True/False)
DEBUG=True
