# =============================================================================
#           LLM-Code-Medic V4 - 工业级智能修复系统环境变量配置
# =============================================================================

# =============================================================================
# 🔥 第一部分：核心用户配置
# =============================================================================

# [必填] 目标测试仓库根目录路径
TEST_REPO_ROOT=./tests/v3

# -----------------------------------------------------------------------------
# 🌐 供应商 API 凭证管理
# -----------------------------------------------------------------------------
# SiliconFlow API Key (使用 DeepSeek 模型时必填)
DEEPSEEK_API_KEY=your_siliconflow_api_key_here
DEEPSEEK_API_BASE=https://api.siliconflow.cn/v1

# Google AI Studio API Key (使用 Gemini 模型时必填)
GEMINI_API_KEY=


# =============================================================================
# ⚙️ 第二部分：双 LLM 协同路由配置 (请根据需求选择)
# =============================================================================

# [诊断阶段] 推荐使用长推理链模型
# 可选值: deepseek (对应 deepseek-ai/DeepSeek-R1) / gemini (对应 gemini-2.0-flash-thinking)
DIAGNOSE_PROVIDER=deepseek
DIAGNOSE_MODEL=deepseek-ai/DeepSeek-R1

# [修复阶段] 推荐使用代码生成协议遵从度高的模型
# 可选值: deepseek (对应 deepseek-ai/DeepSeek-V3) / gemini (对应 gemini-1.5-pro)
REPAIR_PROVIDER=deepseek
REPAIR_MODEL=deepseek-ai/DeepSeek-V3


# =============================================================================
# 🛡️ 第三部分：内核高级默认配置 (通常无需修改)
# =============================================================================

DEBUG=True

# LLM 韧性容灾层 (重试次数/超时时间/指数退避间隔)
LLM_RETRY_COUNT=3
LLM_TIMEOUT=120
LLM_BACKOFF_SECONDS=3

# 自动修复最大迭代轮数熔断上限
MAX_REPAIR_ATTEMPTS=10

# 接口异常时的自动级联降级路由
FALLBACK_PROVIDER=deepseek
FALLBACK_MODEL=deepseek-ai/DeepSeek-V3