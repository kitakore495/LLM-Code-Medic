# =========================================================
# Diagnose Model (错误诊断阶段)
# provider:
#   deepseek / gemini
# example:
#   deepseek-ai/DeepSeek-R1
#   gemini-2.5-flash
# =========================================================
DIAGNOSE_PROVIDER=deepseek
DIAGNOSE_MODEL=deepseek-ai/DeepSeek-R1


# =========================================================
# Repair Model (代码修复阶段)
# provider:
#   deepseek / gemini
# example:
#   deepseek-ai/DeepSeek-V3
#   gemini-2.5-flash
# =========================================================
REPAIR_PROVIDER=deepseek
REPAIR_MODEL=deepseek-ai/DeepSeek-V3


# =========================================================
# DeepSeek (SiliconFlow)
# =========================================================
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.siliconflow.cn/v1


# =========================================================
# Gemini (Google AI Studio)
# https://aistudio.google.com/
# =========================================================
GEMINI_API_KEY=


# =========================================================
# Runtime
# =========================================================
DEBUG=True
# ==================================================
# LLM Resilience Layer
# ==================================================

# ===== Repo =====

TEST_REPO_ROOT=./tests/v3

LLM_RETRY_COUNT=3
LLM_TIMEOUT=120
LLM_BACKOFF_SECONDS=3

FALLBACK_PROVIDER=deepseek
FALLBACK_MODEL=deepseek-ai/DeepSeek-V3