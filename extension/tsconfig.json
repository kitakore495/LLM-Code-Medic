{
    "compilerOptions": {

        "target": "ES2020",

        "module": "Node16",

        "moduleResolution": "Node16",

        "rootDir": "src",

        "outDir": "out",

        "strict": true,

        "esModuleInterop": true,

        "sourceMap": true,

        "skipLibCheck": true,

        "lib": [
            "ES2020",
            "DOM"
        ],

        "types": [
            "node",
            "vscode"
        ]
    },

    "include": [
        "src/**/*"
    ]
}