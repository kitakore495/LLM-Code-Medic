{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run-python-main",
            "type": "shell",
            "command": "python -m src.main",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            }
        }
    ]
}